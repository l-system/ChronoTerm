# Maintainer: Your Name <you@example.com>
pkgname=chronoterm
pkgver=1.0.0
pkgrel=1
pkgdesc="A GPU-rendered, configurable terminal emulator"
arch=('x86_64')
url="https://github.com/l-system/chronoterm"
license=('MIT')

# Framework-dependent build (NOT self-contained) — deliberately depends on
# the distro's dotnet-runtime package rather than bundling one: smaller
# download, and security patches to the runtime come from the system package
# manager instead of requiring a new ChronoTerm release. This mirrors how
# Arch expects shared libraries to be linked rather than vendored.
#
# NOTE: dotnet-runtime's package name tracks whatever .NET major version is
# current in the Arch repos. Check `pacman -Si dotnet-runtime` (or
# dotnet-runtime-<major> if Arch has versioned it by the time you package
# this) matches the <TargetFramework> in ChronoTerm.csproj (net10.0 as of
# this writing) before submitting — a mismatch will fail at runtime, not at
# package-build time, since makedepends' dotnet-sdk and depends'
# dotnet-runtime are resolved independently.
depends=('dotnet-runtime' 'glfw' 'fontconfig' 'util-linux')
makedepends=('dotnet-sdk')

source=("$pkgname-$pkgver.tar.gz::https://github.com/l-system/chronoterm/archive/refs/tags/v$pkgver.tar.gz")
# Fill this in with `updpkgsums` after downloading the real tarball — a
# placeholder here will make makepkg refuse to build, which is intentional;
# don't skip integrity checking for a source tarball (SKIP is only
# appropriate for VCS sources, not this).
sha256sums=('REPLACE_ME_WITH_updpkgsums_OUTPUT')

build() {
    cd "$pkgname-$pkgver"
    export DOTNET_CLI_TELEMETRY_OPTOUT=1
    export DOTNET_NOLOGO=1
    dotnet publish ChronoTerm -c Release -r linux-x64 --self-contained false \
        -p:PublishReadyToRun=false -o publish-output
}

package() {
    cd "$pkgname-$pkgver"

    install -dm755 "$pkgdir/usr/lib/$pkgname"
    cp -r publish-output/* "$pkgdir/usr/lib/$pkgname/"

    install -dm755 "$pkgdir/usr/bin"
    ln -s "/usr/lib/$pkgname/ChronoTerm" "$pkgdir/usr/bin/chronoterm"

    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

    if [ -f aur/chronoterm.desktop ]; then
        install -Dm644 aur/chronoterm.desktop \
            "$pkgdir/usr/share/applications/chronoterm.desktop"
    fi

    # The window/taskbar icon is embedded in the binary itself (see
    # ChronoTerm.csproj's EmbeddedResource) and needs no install step — this
    # copy is purely for the .desktop launcher above, which resolves
    # Icon=chronoterm through the freedesktop icon theme search path, not
    # from inside the assembly.
    if [ -f assets/icon.png ]; then
        install -Dm644 assets/icon.png \
            "$pkgdir/usr/share/icons/hicolor/128x128/apps/chronoterm.png"
    fi
}
