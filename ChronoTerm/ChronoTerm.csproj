<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!-- Safe here: no localized/culture-sensitive user-facing text anywhere
             in the app (config values are just numbers). Trims ICU data from
             every build, not just Release, for a real size/startup win. -->
        <InvariantGlobalization>true</InvariantGlobalization>

        <Version>1.0.0</Version>
        <Product>ChronoTerm</Product>
        <Authors>ChronoTerm contributors</Authors>
        <Description>A GPU-rendered, configurable terminal emulator for Linux.</Description>
        <RootNamespace>ChronoTerm</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Silk.NET.Windowing" Version="2.23.0" />
        <PackageReference Include="Silk.NET.Input" Version="2.23.0" />
        <PackageReference Include="Silk.NET.OpenGL" Version="2.23.0" />
        <PackageReference Include="Silk.NET.Maths" Version="2.23.0" />
        <PackageReference Include="Silk.NET.GLFW" Version="2.23.0" />
        <!-- Pinned BELOW Six Labors' license-key enforcement threshold (ImageSharp
             4.0.0 / ImageSharp.Drawing 3.0.0 / Fonts 3.0.0 all now require a
             sixlabors.lic file to build, even under the free Apache 2.0 tier).
             These versions predate that and are still plain Apache 2.0, no key. -->
        <PackageReference Include="SixLabors.Fonts" Version="2.1.3" />
        <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
        <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="2.1.5" />
        <PackageReference Include="YamlDotNet" Version="18.1.0" />
    </ItemGroup>

    <!-- Only kicks in when a publish invocation explicitly passes
         -p:SelfContained=true (e.g. `dotnet publish -c Release -r linux-x64
         --self-contained true`, per the GitHub Releases build instructions in
         README.md) — NOT for the AUR package (aur/PKGBUILD), which deliberately
         builds framework-dependent against the distro's dotnet-runtime package
         instead of bundling one. RuntimeIdentifier is deliberately left unset
         here rather than hardcoded to linux-x64, so an arm64 build only needs
         `-r linux-arm64` on the command line, no csproj edit. -->
    <PropertyGroup Condition="'$(Configuration)'=='Release' And '$(SelfContained)'=='true'">
        <PublishSingleFile>true</PublishSingleFile>
        <PublishReadyToRun>true</PublishReadyToRun>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <!-- Folds debug symbols into the binary itself instead of a separate
             .pdb, so a self-contained publish is exactly two files:
             ChronoTerm and libglfw.so.3 (which can't be embedded — see
             README.md's note on Silk.NET's native GLFW loading). -->
        <DebugType>embedded</DebugType>
    </PropertyGroup>

</Project>
